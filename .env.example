# Copy to .env. See README "Settings" for what production requires.
# Keep comments on their own lines; an inline "# ..." becomes part of the value.

# Core
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.example.com

# Database (empty: local SQLite)
DATABASE_URL=

# Frontends
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=

# Public URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# The same value as the website's REVALIDATE_SECRET; empty: website edits show within five minutes
WEBSITE_REVALIDATE_SECRET=

# SMS ("console" only logs messages)
SMS_BACKEND=console
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# Store-review account (empty DEMO_PHONE disables it)
DEMO_PHONE=
DEMO_OTP_CODE=000000

# Payments
SSLCOMMERZ_IS_SANDBOX=True
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SUCCESS_REDIRECT=http://localhost:3000/payment/success
SSLCOMMERZ_FAIL_REDIRECT=http://localhost:3000/payment/fail
SSLCOMMERZ_CANCEL_REDIRECT=http://localhost:3000/payment/cancel

# Production only (defaults shown)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
