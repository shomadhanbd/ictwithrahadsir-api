# Copy this file to .env and fill in real values for your environment.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in production/docker-compose, e.g.:
# DATABASE_URL=postgres://ictwithrahadsir:password@db:5432/ictwithrahadsir
# Leave unset to fall back to local SQLite for zero-config development.
DATABASE_URL=

TIME_ZONE=Asia/Dhaka

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_ALL_ORIGINS=True

FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# Object storage (DigitalOcean Spaces / S3). Leave USE_S3=False to store
# uploads on local disk under MEDIA_ROOT instead.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sgp1
AWS_S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=

# Cache. Backs the auth rate limits below, so in production this should be a
# shared Redis -- the default in-process cache gives each gunicorn worker its
# own throttle counter. Requires `pip install redis` when set.
# CACHE_URL=redis://redis:6379/1

# Auth rate limits (per client IP). Burst stops the scripted attack, the
# sustained one stops the slow drip that would sit under any per-minute cap.
# Keep the burst loose enough for users sharing a carrier NAT address.
THROTTLE_LOGIN_BURST=10/min
THROTTLE_LOGIN_SUSTAINED=100/hour
THROTTLE_AUTH_BURST=10/min
THROTTLE_AUTH_SUSTAINED=60/hour

# SMS / OTP delivery. "console" logs OTP codes instead of sending real SMS.
SMS_BACKEND=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

PAYMENT_RECEIVE_NUMBER=01711778602
