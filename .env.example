# Copy this file to .env and fill in real values for your environment.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in production, e.g.:
# DATABASE_URL=postgres://ictwithrahadsir:password@localhost:5432/ictwithrahadsir
# Leave unset to fall back to local SQLite for zero-config development.
DATABASE_URL=

TIME_ZONE=Asia/Dhaka

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_ALL_ORIGINS=True

# Cache. Backs the auth rate limits below, so in production this should be a
# shared Redis -- the default in-process cache gives each gunicorn worker its
# own throttle counter. Requires `pip install redis` when set.
# CACHE_URL=redis://redis:6379/1

# Auth rate limits (per client IP). Burst stops the scripted attack, the
# sustained one stops the slow drip that would sit under any per-minute cap.
# Keep the burst loose enough for users sharing a carrier NAT address.
THROTTLE_LOGIN_BURST=10/min
THROTTLE_LOGIN_SUSTAINED=100/hour
THROTTLE_AUTH_BURST=10/min
THROTTLE_AUTH_SUSTAINED=60/hour

# SMS / OTP delivery. "console" logs OTP codes instead of sending real SMS;
# "bulksmsbd" sends through bulksmsbd.net using the two credentials below.
SMS_BACKEND=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_TEMPLATE=Your ICT with Rahad Sir verification code is {code}

BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# Hourly caps on codes *sent*, counted in the database so they survive a cache
# restart -- the cooldown above only stops double-taps, these stop a script
# draining the SMS balance. Set NUM_PROXIES in REST_FRAMEWORK when running
# behind a load balancer or the per-IP half sees only the proxy.
OTP_RATE_LIMIT_PER_PHONE_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_HOUR=20

# How long a verified phone stays eligible to finish registration.
REGISTRATION_WINDOW_SECONDS=1800

# Reviewer account that skips the SMS and accepts a fixed code. Leave
# DEMO_PHONE empty to disable -- an always-on one is a standing backdoor.
DEMO_PHONE=
DEMO_OTP_CODE=000000

# Payments. SSLCommerz is the only gateway. Leave SANDBOX=True until the live
# store is approved. Register <API_BASE_URL>/api/public/payments/sslcommerz/ipn/
# as the IPN URL in the SSLCommerz merchant panel; it must be publicly
# reachable (use a tunnel when testing the sandbox locally).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True
API_BASE_URL=http://localhost:8000
PAYMENT_RESULT_URL=http://localhost:3000/payment/result
